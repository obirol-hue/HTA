<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>Web Surec Analizci - Test Araci</title>
<HTA:APPLICATION
    ID="SurecAnalizci"
    APPLICATIONNAME="WebSurecAnalizci"
    BORDER="thin"
    CAPTION="yes"
    ICON=""
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    SCROLL="yes"
    VERSION="1.0"
    WINDOWSTATE="normal"
/>
<style type="text/css">
    body {
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
        background: #f4f6f9;
        color: #222;
        margin: 0;
        padding: 0;
        font-size: 13px;
    }
    .header {
        background: #1f2d3d;
        color: #fff;
        padding: 14px 20px;
    }
    .header h1 { margin: 0; font-size: 18px; font-weight: 600; }
    .header p { margin: 4px 0 0; font-size: 12px; color: #aab4c0; }
    .panel {
        background: #fff;
        margin: 14px 20px;
        padding: 16px;
        border: 1px solid #dce1e7;
        border-radius: 6px;
    }
    .row { margin-bottom: 10px; }
    label { display: inline-block; width: 130px; vertical-align: middle; font-weight: 600; }
    input[type=text] {
        width: 60%;
        padding: 6px 8px;
        border: 1px solid #b5bcc4;
        border-radius: 4px;
        font-size: 13px;
    }
    input[type=number] { width: 70px; padding: 5px; border: 1px solid #b5bcc4; border-radius: 4px; }
    button {
        background: #2d7ff9;
        color: #fff;
        border: none;
        padding: 8px 18px;
        font-size: 13px;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 600;
    }
    button:hover { background: #1c6ae0; }
    button.secondary { background: #6c7a89; }
    button.secondary:hover { background: #58646f; }
    button:disabled { background: #b5bcc4; cursor: default; }
    #status {
        margin: 0 20px;
        padding: 8px 14px;
        font-size: 12px;
        color: #555;
        min-height: 16px;
    }
    .report h2 {
        font-size: 15px;
        border-bottom: 2px solid #2d7ff9;
        padding-bottom: 4px;
        margin-top: 22px;
        color: #1f2d3d;
    }
    table { border-collapse: collapse; width: 100%; margin-top: 8px; font-size: 12px; }
    th, td { border: 1px solid #dce1e7; padding: 6px 9px; text-align: left; vertical-align: top; }
    th { background: #eef2f6; font-weight: 600; }
    .tag { display: inline-block; background: #eef2f6; border: 1px solid #cdd6df; border-radius: 3px; padding: 1px 7px; margin: 2px; font-size: 11px; }
    .ok { color: #1a8a4a; font-weight: 600; }
    .warn { color: #c47f00; font-weight: 600; }
    .err { color: #c0392b; font-weight: 600; }
    .muted { color: #888; }
    .summary-grid td { width: 25%; }
    .summary-grid .num { font-size: 20px; font-weight: 700; color: #2d7ff9; }
    pre { background: #f7f9fb; border: 1px solid #e1e7ee; padding: 8px; overflow: auto; max-height: 220px; font-size: 11px; }
    .step { background: #f7f9fb; border-left: 3px solid #2d7ff9; padding: 8px 12px; margin: 6px 0; }
    .step b { color: #1f2d3d; }
</style>
</head>

<body>
<div class="header">
    <h1>Web Surec Analizci</h1>
    <p>Girilen adrese baglanir, sayfanin tum sureclerini analiz eder ve surec dokumani (rapor) cikarir. Tamamen test/analiz amaclidir.</p>
</div>

<div class="panel">
    <div class="row">
        <label>Hedef URL:</label>
        <input type="text" id="urlInput" value="https://" />
    </div>
    <div class="row">
        <label>Link tarama:</label>
        <input type="checkbox" id="crawlChk" /> Ic baglantilari tara (1 seviye)
        &nbsp;&nbsp; Maks. sayfa: <input type="number" id="maxPages" value="5" min="1" max="30" />
    </div>
    <div class="row">
        <label>Zaman asimi (sn):</label>
        <input type="number" id="timeoutSec" value="20" min="5" max="120" />
    </div>
    <div class="row">
        <label>Test verisi:</label>
        <input type="checkbox" id="genDataChk" checked /> Anlamli test verisi ve senaryolar uret
    </div>
    <div class="row">
        <label>Canli gonderim:</label>
        <input type="checkbox" id="liveSubmitChk" /> <span class="err">Formlari uretilen test verisiyle GERCEKTEN gonder</span>
        <span class="muted">(varsayilan: sadece onizleme. Yalnizca yetkili oldugunuz sitelerde acin!)</span>
    </div>

    <div class="row" style="border-top:1px solid #e1e7ee; padding-top:10px; margin-top:10px;">
        <label>Otomatik giris:</label>
        <input type="checkbox" id="loginChk" onclick="toggleLogin()" />
        <span class="err">Siteye otomatik giris yap ve oturumla gez</span>
        <span class="muted">(yalnizca yetkili/kendi sitenizde!)</span>
    </div>
    <div id="loginFields" style="display:none;">
        <div class="row">
            <label>Giris sayfasi URL:</label>
            <input type="text" id="loginUrl" placeholder="bos birakilirsa Hedef URL kullanilir" />
        </div>
        <div class="row">
            <label>Kullanici/E-posta:</label>
            <input type="text" id="loginUser" />
            &nbsp; Alan adi (ops.): <input type="text" id="loginUserField" style="width:120px;" placeholder="otomatik" />
        </div>
        <div class="row">
            <label>Sifre:</label>
            <input type="password" id="loginPass" />
            &nbsp; Alan adi (ops.): <input type="text" id="loginPassField" style="width:120px;" placeholder="otomatik" />
        </div>
        <div class="row">
            <label></label>
            <span class="muted">Giris sonrasi gezinme icin yukaridaki "Ic baglantilari tara" secenegini de acin.</span>
        </div>
    </div>

    <div class="row" style="margin-top:14px;">
        <button id="analyzeBtn" onclick="startAnalysis()">Analizi Baslat</button>
        <button class="secondary" id="saveBtn" onclick="saveReport()" disabled>Raporu Kaydet (HTML)</button>
        <button class="secondary" onclick="clearReport()">Temizle</button>
    </div>
</div>

<div id="status">Hazir. Bir URL girip "Analizi Baslat" deyin.</div>

<div class="panel report" id="report" style="display:none;"></div>

<script language="JScript">

// ============================================================
//  Web Surec Analizci - HTA Test Araci
//  Varsayilan: pasif analiz + test verisi/senaryo URETIMI
//  (onizleme). "Canli gonderim" acilirsa formlar uretilen
//  test verisiyle gercekten gonderilir - yalnizca yetkili
//  test ortamlarinda kullanilmalidir.
// ============================================================

var lastReportHtml = "";

function $(id) { return document.getElementById(id); }

function toggleLogin() { $("loginFields").style.display = $("loginChk").checked ? "block" : "none"; }

function setStatus(msg, cls) {
    var s = $("status");
    s.innerHTML = msg;
    s.className = cls || "";
}

function esc(t) {
    if (t === null || typeof t === "undefined") return "";
    return String(t).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function nowMs() { return (new Date()).getTime(); }

// ---- HTTP istegi (ServerXMLHTTP, tam header + cross-domain) ----
function httpSend(method, url, body, contentType, timeoutSec) {
    var result = { ok: false, status: 0, statusText: "", headers: "", body: "", finalUrl: url, timeMs: 0, error: "" };
    var xhr;
    try {
        xhr = new ActiveXObject("Msxml2.ServerXMLHTTP.6.0");
    } catch (e1) {
        try { xhr = new ActiveXObject("MSXML2.ServerXMLHTTP"); }
        catch (e2) {
            try { xhr = new ActiveXObject("Microsoft.XMLHTTP"); }
            catch (e3) { result.error = "XMLHTTP nesnesi olusturulamadi."; return result; }
        }
    }
    var start = nowMs();
    try {
        try { xhr.setTimeouts(timeoutSec*1000, timeoutSec*1000, timeoutSec*1000, timeoutSec*1000); } catch (eT) {}
        xhr.open(method, url, false);
        // Tarayici gibi davran: bazi siteler (haber siteleri vb.) tarayici-disi
        // User-Agent'lari 403 ile engeller. Gercekci basliklarla istek yapilir.
        try { xhr.setRequestHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"); } catch (eH) {}
        try { xhr.setRequestHeader("Accept", "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"); } catch (eA) {}
        try { xhr.setRequestHeader("Accept-Language", "tr-TR,tr;q=0.9,en;q=0.8"); } catch (eL) {}
        if (contentType) { try { xhr.setRequestHeader("Content-Type", contentType); } catch (eC) {} }
        xhr.send(body || "");
        result.timeMs = nowMs() - start;
        result.status = xhr.status;
        result.statusText = xhr.statusText;
        try { result.headers = xhr.getAllResponseHeaders(); } catch (eHh) {}
        result.body = xhr.responseText || "";
        try { result.finalUrl = xhr.getResponseHeader("Content-Location") || url; } catch (eFu) {}
        result.ok = (xhr.status >= 200 && xhr.status < 400) || xhr.status === 0;
    } catch (eS) {
        result.timeMs = nowMs() - start;
        result.error = (eS && eS.message) ? eS.message : "Baglanti hatasi";
    }
    return result;
}

// ---- Oturumlu istek (WinHttpRequest: cerez + yonlendirme otomatik) ----
// Ayni nesne tekrar kullanildiginda cerezler oturum boyunca korunur;
// boylece giris yapildiktan sonra gezilen sayfalar kimlik dogrulamali olur.
function createSession() {
    var s = { http: null, ok: false, loggedIn: false };
    try { s.http = new ActiveXObject("WinHttp.WinHttpRequest.5.1"); s.ok = true; }
    catch (e) { s.http = null; s.ok = false; }
    return s;
}
function httpSendWin(session, method, url, body, contentType, timeoutSec) {
    var result = { ok: false, status: 0, statusText: "", headers: "", body: "", finalUrl: url, timeMs: 0, error: "" };
    var w = session.http;
    var start = nowMs();
    try {
        try { w.SetTimeouts(timeoutSec*1000, timeoutSec*1000, timeoutSec*1000, timeoutSec*1000); } catch (eT) {}
        w.Open(method, url, false);
        try { w.SetRequestHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"); } catch (eH) {}
        try { w.SetRequestHeader("Accept", "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"); } catch (eA) {}
        try { w.SetRequestHeader("Accept-Language", "tr-TR,tr;q=0.9,en;q=0.8"); } catch (eL) {}
        if (contentType) { try { w.SetRequestHeader("Content-Type", contentType); } catch (eC) {} }
        w.Send(body || "");
        result.timeMs = nowMs() - start;
        result.status = w.Status;
        result.statusText = w.StatusText;
        try { result.headers = w.GetAllResponseHeaders(); } catch (eHh) {}
        result.body = w.ResponseText || "";
        try { result.finalUrl = w.Option(1) || url; } catch (eFu) {} // Option(1)=WinHttpRequestOption_URL (son URL)
        result.ok = (w.Status >= 200 && w.Status < 400);
    } catch (eS) {
        result.timeMs = nowMs() - start;
        result.error = (eS && eS.message) ? eS.message : "Baglanti hatasi";
    }
    return result;
}
// Dagitici: oturum varsa WinHttp (kimlik dogrulamali), yoksa ServerXMLHTTP
function request(method, url, body, contentType, timeoutSec, session) {
    if (session && session.http) return httpSendWin(session, method, url, body, contentType, timeoutSec);
    return httpSend(method, url, body, contentType, timeoutSec);
}
function httpGet(url, timeoutSec, session) { return request("GET", url, null, null, timeoutSec, session); }

// ---- HTML'i guvenli sekilde ayristir (htmlfile ActiveX) ----
function parseHtml(html) {
    var doc;
    try {
        doc = new ActiveXObject("htmlfile");
        doc.open();
        doc.write(html);
        doc.close();
    } catch (e) {
        doc = null;
    }
    return doc;
}

function getHeaderValue(headers, name) {
    var re = new RegExp("^" + name + "\\s*:\\s*(.+)$", "im");
    var m = re.exec(headers || "");
    return m ? trim(m[1]) : "";
}

function trim(s) { return String(s).replace(/^\s+|\s+$/g, ""); }

// ---- URL yardimcilari ----
function getDomain(url) {
    var m = /^https?:\/\/([^\/\?#]+)/i.exec(url);
    return m ? m[1].toLowerCase() : "";
}
function absoluteUrl(base, href) {
    if (!href) return "";
    href = trim(href);
    if (/^(javascript:|mailto:|tel:|#|data:)/i.test(href)) return "";
    if (/^https?:\/\//i.test(href)) return href;
    var m = /^(https?:\/\/[^\/]+)(\/[^\?#]*)?/i.exec(base);
    if (!m) return "";
    var origin = m[1];
    var path = m[2] || "/";
    if (href.indexOf("//") === 0) return "http:" + href;
    if (href.charAt(0) === "/") return origin + href;
    var dir = path.replace(/\/[^\/]*$/, "/");
    return origin + dir + href;
}

// ---- Teknoloji tespiti ----
function detectTech(headers, body) {
    var tech = [];
    function add(t) { for (var i=0;i<tech.length;i++){ if(tech[i]===t) return; } tech.push(t); }
    var server = getHeaderValue(headers, "Server");
    if (server) add("Server: " + server);
    var xpb = getHeaderValue(headers, "X-Powered-By");
    if (xpb) add("X-Powered-By: " + xpb);
    var b = body.toLowerCase();
    if (/wp-content|wp-includes/.test(b)) add("WordPress");
    if (/drupal/.test(b)) add("Drupal");
    if (/joomla/.test(b)) add("Joomla");
    if (/react|__react|reactdom/.test(b)) add("React");
    if (/ng-version|angular/.test(b)) add("Angular");
    if (/vue(\.|__|js)/.test(b)) add("Vue.js");
    if (/jquery/.test(b)) add("jQuery");
    if (/bootstrap/.test(b)) add("Bootstrap");
    if (/gtag\(|google-analytics|googletagmanager/.test(b)) add("Google Analytics/Tag");
    if (/cloudflare/.test((headers||"").toLowerCase())) add("Cloudflare");
    if (/x-shopify|shopify/.test(b)) add("Shopify");
    if (/laravel_session|laravel/.test((headers||"").toLowerCase())) add("Laravel");
    if (/asp\.net|__viewstate/i.test(body)) add("ASP.NET");
    return tech;
}

// ---- Buton yardimcilari ----
function addButton(page, label, type, source) {
    label = trim(label || "");
    if (!label) return;
    if (page.buttons.length >= 60) return;
    for (var i = 0; i < page.buttons.length; i++) {
        if (page.buttons[i].label === label && page.buttons[i].type === type) return;
    }
    page.buttons.push({ label: label, type: type, source: source, purpose: guessActionPurpose(label, "") });
}
function collectButtons(coll, page, url, src) {
    for (var i = 0; i < coll.length; i++) {
        var t = trim(coll[i].innerText || coll[i].textContent || coll[i].getAttribute("value") || coll[i].getAttribute("aria-label") || coll[i].getAttribute("title") || "");
        var bt = (coll[i].getAttribute("type") || "button").toLowerCase();
        addButton(page, t, bt, src);
    }
}

// ---- Bir buton/baglantinin ne yaptigini tahmin et ----
function guessActionPurpose(text, url) {
    var t = (text + " " + (url || "")).toLowerCase();
    if (/sifremi unut|sifre sifirla|forgot.*pass|reset.*pass|parolami unut/.test(t)) return "Sifre sifirlama";
    if (/giris|login|sign in|oturum a/.test(t)) return "Oturum acma (giris)";
    if (/cikis|logout|sign out|oturumu kapat/.test(t)) return "Oturumu kapatma";
    if (/kayit|register|sign up|uye ol|kaydol/.test(t)) return "Yeni kayit / uyelik";
    if (/ara|search|bul/.test(t)) return "Arama";
    if (/sepet|cart|basket/.test(t)) return "Sepet islemi";
    if (/odeme|checkout|payment|satin al|order|siparis/.test(t)) return "Odeme / siparis";
    if (/ekle|add/.test(t)) return "Ekleme islemi";
    if (/sil|delete|remove|kaldir/.test(t)) return "Silme islemi";
    if (/gonder|submit|kaydet|save|onayla|confirm|tamam|apply|uygula/.test(t)) return "Form gonderme / kaydetme";
    if (/iletisim|contact|bize ulas/.test(t)) return "Iletisim";
    if (/indir|download/.test(t)) return "Indirme";
    if (/yukle|upload/.test(t)) return "Yukleme";
    if (/devam|next|ileri|continue|sonraki/.test(t)) return "Sonraki adima gecis";
    if (/geri|back|onceki|previous/.test(t)) return "Onceki adima donus";
    if (/iptal|cancel|vazgec/.test(t)) return "Iptal";
    if (/menu|hamburger|nav/.test(t)) return "Menu / gezinme";
    if (/hakkinda|about|kurumsal/.test(t)) return "Bilgi sayfasi";
    if (/anasayfa|home|ana sayfa/.test(t)) return "Ana sayfaya gidis";
    if (/profil|account|hesab|profile/.test(t)) return "Hesap / profil";
    if (/dil|language|lang|en|tr/.test(t)) return "Dil degistirme";
    return "Gezinme / aksiyon";
}

// ---- Bir giris alaninin en anlamli etiketini bul ----
function fieldLabel(doc, el) {
    var parts = [];
    var ph = el.getAttribute("placeholder"); if (ph) parts.push(trim(ph));
    var al = el.getAttribute("aria-label"); if (al) parts.push(trim(al));
    // <label for="id">
    var id = el.getAttribute("id");
    if (id) {
        try {
            var labs = doc.getElementsByTagName("label");
            for (var i = 0; i < labs.length; i++) {
                if (labs[i].getAttribute("for") === id) {
                    var lt = trim(labs[i].innerText || labs[i].textContent || "");
                    if (lt) { parts.push(lt); break; }
                }
            }
        } catch (e) {}
    }
    var nm = el.getAttribute("name") || el.getAttribute("id");
    if (nm) parts.push(trim(nm));
    return parts.length ? parts[0] : "(adsiz)";
}

// ---- Bir giris alaninin ne topladigini yorumla ----
function guessFieldPurpose(type, name, label) {
    type = (type || "").toLowerCase();
    var t = ((name || "") + " " + (label || "")).toLowerCase();
    if (type === "password" || /sifre|parola|password|pass/.test(t)) return "Sifre / parola";
    if (type === "email" || /e-?mail|e-?posta|eposta/.test(t)) return "E-posta adresi";
    if (type === "tel" || /telefon|phone|gsm|cep|mobile/.test(t)) return "Telefon numarasi";
    if (type === "search" || /search|\bara\b|arama|query|keyword|\bq\b/.test(t)) return "Arama terimi";
    if (type === "number" || /miktar|adet|quantity|qty|amount|tutar|fiyat|price|yas|age/.test(t)) return "Sayisal deger";
    if (type === "date" || type === "datetime-local" || /tarih|date|dogum|birth/.test(t)) return "Tarih";
    if (type === "file") return "Dosya yukleme";
    if (type === "checkbox") return "Onay kutusu (evet/hayir secimi)";
    if (type === "radio") return "Secenek (tekli secim)";
    if (type === "hidden") return "Gizli alan (sistem verisi)";
    if (type === "url" || /url|website|web sitesi|link/.test(t)) return "Web adresi";
    if (type === "color") return "Renk secimi";
    if (type === "range") return "Kaydirac (deger araligi)";
    if (/kullanici|username|user_?name|nick|rumuz/.test(t)) return "Kullanici adi";
    if (/ad|isim|name|fname|firstname/.test(t) && !/kullanici|user/.test(t)) return "Ad / isim";
    if (/soyad|surname|lastname|lname/.test(t)) return "Soyad";
    if (/adres|address|sehir|city|posta|zip|ulke|country|il\b|ilce/.test(t)) return "Adres bilgisi";
    if (/kart|card|cvv|iban|hesap no/.test(t)) return "Odeme / kart bilgisi";
    if (/mesaj|message|yorum|comment|aciklama|note/.test(t)) return "Mesaj / serbest metin";
    if (/tc|kimlik|identity|ssn|vergi|tax/.test(t)) return "Kimlik / vergi no";
    if (type === "select" || type === "select-one") return "Acilir liste secimi";
    if (type === "textarea") return "Uzun metin girisi";
    return "Metin girisi";
}

// ==================================================================
//  TEST VERISI URETIMI - alanin formatina gore anlamli deger
//  variant: "valid" | "invalid" | "empty" | "boundary" | "xss" | "sqli"
// ==================================================================
var _rnd = (function(){ var c = (new Date()).getTime() % 100000; return function(){ c++; return c; }; })();

function generateTestValue(field, variant) {
    var type = (field.type || "").toLowerCase();
    var purpose = field.purpose || "";
    var name = (field.name || "") + " " + (field.label || "");

    if (variant === "empty") return "";
    if (variant === "xss")  return "<script>alert(1)<\/script>";
    if (variant === "sqli") return "' OR '1'='1";

    // ---- gecerli (valid) degerler ----
    if (variant === "valid" || !variant) {
        if (purpose === "E-posta adresi" || type === "email") return "test.kullanici" + _rnd() + "@example.com";
        if (purpose === "Sifre / parola" || type === "password") return "Test1234!" + _rnd();
        if (purpose === "Telefon numarasi" || type === "tel") return "0555" + (1000000 + (_rnd() % 8999999));
        if (purpose === "Arama terimi" || type === "search") return "test";
        if (purpose === "Sayisal deger" || type === "number") return clampNum(field, 42);
        if (purpose === "Tarih" || type === "date") return "2000-01-15";
        if (type === "datetime-local") return "2000-01-15T10:30";
        if (purpose === "Web adresi" || type === "url") return "https://example.com";
        if (type === "color") return "#3366cc";
        if (type === "range") return clampNum(field, 50);
        if (type === "checkbox") return "on";
        if (type === "radio") return field.value || "1";
        if (type === "file") return "C:\\test\\ornek.txt";
        if (purpose === "Kullanici adi") return "testuser" + _rnd();
        if (purpose === "Ad / isim") return "Ahmet";
        if (purpose === "Soyad") return "Yilmaz";
        if (purpose === "Adres bilgisi") return "Test Mah. Deneme Sok. No:1, Istanbul";
        if (purpose === "Odeme / kart bilgisi") {
            if (/cvv/.test(name.toLowerCase())) return "123";
            if (/iban/.test(name.toLowerCase())) return "TR000000000000000000000000";
            return "4111111111111111"; // standart test kart numarasi
        }
        if (purpose === "Kimlik / vergi no") return "10000000146"; // format-gecerli ornek
        if (purpose === "Mesaj / serbest metin" || type === "textarea") return "Bu bir otomatik test mesajidir.";
        if (purpose === "Acilir liste secimi" || type === "select" || type === "select-one") return field.firstOption || "";
        return "test" + _rnd();
    }

    // ---- gecersiz (invalid) degerler: format ihlali ----
    if (variant === "invalid") {
        if (purpose === "E-posta adresi" || type === "email") return "gecersiz-eposta";
        if (purpose === "Telefon numarasi" || type === "tel") return "abc";
        if (purpose === "Sayisal deger" || type === "number" || type === "range") return "metin";
        if (purpose === "Tarih" || type === "date") return "32/13/9999";
        if (purpose === "Web adresi" || type === "url") return "htp:/yanlis";
        if (purpose === "Sifre / parola" || type === "password") return "123"; // zayif
        return "!!!";
    }

    // ---- sinir (boundary) degerler ----
    if (variant === "boundary") {
        if (type === "number" || type === "range") {
            var max = field.max; return (max !== null && max !== "" && typeof max !== "undefined") ? max : "999999999";
        }
        var ml = parseInt(field.maxlength, 10);
        var len = (!isNaN(ml) && ml > 0) ? ml : 256;
        return repeatStr("A", len);
    }
    return "test";
}
function clampNum(field, def) {
    var mn = parseInt(field.min, 10), mx = parseInt(field.max, 10);
    if (!isNaN(mn) && def < mn) def = mn;
    if (!isNaN(mx) && def > mx) def = mx;
    return String(def);
}
function repeatStr(s, n) { var o = ""; for (var i = 0; i < n && i < 5000; i++) o += s; return o; }

// ---- Bir form icin test senaryolari uret ----
function buildScenarios(form) {
    var sc = [];
    var entry = (form.fields.length > 0);
    if (entry) {
        sc.push({ name: "Gecerli veri (happy path)", desc: "Tum alanlar formatina uygun gecerli verilerle doldurulur; basarili gonderim beklenir.", variant: "valid" });
        // zorunlu alanlar
        var req = [];
        for (var i = 0; i < form.fields.length; i++) if (form.fields[i].required) req.push(form.fields[i]);
        if (req.length) {
            sc.push({ name: "Zorunlu alan(lar) bos", desc: "Zorunlu alanlar bos birakilir (" + reqNames(req) + "); dogrulama hatasi/uyari beklenir.", variant: "empty-required" });
        }
        // gecersiz format - format dogrulamasi olan alanlar varsa
        var fmt = [];
        for (var j = 0; j < form.fields.length; j++) {
            var t = (form.fields[j].type || "").toLowerCase(), p = form.fields[j].purpose;
            if (t==="email"||t==="number"||t==="tel"||t==="date"||t==="url"||t==="range"||p==="E-posta adresi"||p==="Telefon numarasi"||p==="Sayisal deger"||p==="Tarih"||p==="Web adresi") fmt.push(form.fields[j]);
        }
        if (fmt.length) sc.push({ name: "Gecersiz format", desc: "Format dogrulamasi olan alanlara hatali deger girilir; reddedilmesi beklenir.", variant: "invalid" });
        sc.push({ name: "Sinir deger (uzun/maks)", desc: "Maksimum uzunluk veya maks. sayisal degerle test; tasma/kesme davranisi gozlenir.", variant: "boundary" });
        sc.push({ name: "Guvenlik: XSS denemesi", desc: "Alanlara <script> yuku girilir; ciktida temizlenip temizlenmedigi (yansima) kontrol edilir.", variant: "xss" });
        sc.push({ name: "Guvenlik: SQL injection denemesi", desc: "Klasik ' OR '1'='1 yuku girilir; hata mesaji/anormal davranis aranir.", variant: "sqli" });
    } else {
        sc.push({ name: "Gezinme dogrulamasi", desc: "Bu surec veri girisi icermiyor; baglanti/buton hedefinin dogru sayfaya gittigi kontrol edilir.", variant: "nav" });
    }
    return sc;
}
function reqNames(arr) { var o = []; for (var i = 0; i < arr.length && i < 5; i++) o.push(arr[i].label || arr[i].name); return o.join(", "); }

// ---- Form icin istek govdesi/URL olustur (gonderim veya onizleme) ----
function buildFormRequest(form, variant) {
    var pairs = [];
    for (var i = 0; i < form.fields.length; i++) {
        var fld = form.fields[i];
        if (fld.name === "(adsiz)" || !fld.name) continue;
        var v;
        if (fld.type === "hidden") v = fld.value || "";       // CSRF/token gibi gizli alanlari KORU
        else if (variant === "empty-required") v = fld.required ? "" : generateTestValue(fld, "valid");
        else v = generateTestValue(fld, variant);
        pairs.push(encodeURIComponent(fld.name) + "=" + encodeURIComponent(v));
    }
    var body = pairs.join("&");
    var method = (form.method || "GET").toUpperCase();
    var isGet = (method.indexOf("GET") === 0);
    var action = form.action;
    if (action === "(istemci tarafi)") action = "";
    var reqUrl = action;
    if (isGet && action && body) reqUrl = action + (action.indexOf("?") >= 0 ? "&" : "?") + body;
    return { method: isGet ? "GET" : (method === "POST" ? "POST" : "POST"), url: reqUrl, body: isGet ? "" : body, isGet: isGet, formBody: body, action: action };
}

// ---- Yaniti basit degerlendir (senaryo sonucu) ----
function evalResponse(variant, res) {
    if (res.error) return { verdict: "warn", note: "Istek hatasi: " + res.error };
    var b = (res.body || "").toLowerCase();
    if (variant === "xss") {
        if (res.body && res.body.indexOf("<script>alert(1)<\/script>") >= 0)
            return { verdict: "err", note: "DIKKAT: XSS yuku ciktida ESCAPE EDILMEDEN yansidi (olasi zafiyet)." };
        return { verdict: "ok", note: "XSS yuku ciktida ham olarak yansimadi." };
    }
    if (variant === "sqli") {
        if (/sql syntax|mysql|odbc|ora-\d|sqlite|unclosed quotation|syntax error/.test(b))
            return { verdict: "err", note: "DIKKAT: Yanitta veritabani hata izi var (olasi SQLi)." };
        return { verdict: "ok", note: "Belirgin DB hata izi yok." };
    }
    if (variant === "empty-required") {
        if (/zorunlu|gerekli|required|bos birak|doldur|invalid|hata/.test(b))
            return { verdict: "ok", note: "Sunucu bos zorunlu alani yakaladi (dogrulama calisiyor)." };
        return { verdict: "warn", note: "Dogrulama mesaji gorunmuyor; sunucu tarafi dogrulama eksik olabilir." };
    }
    if (res.status >= 200 && res.status < 400) return { verdict: "ok", note: "Yanit " + res.status + " (" + res.timeMs + " ms)." };
    return { verdict: "warn", note: "Yanit " + res.status + " " + res.statusText + "." };
}

// ==================================================================
//  OTOMATIK GIRIS - giris formunu bul ve kimlik bilgileriyle gonder
// ==================================================================
function findLoginForm(doc, baseUrl) {
    var forms = doc.getElementsByTagName("form");
    for (var i = 0; i < forms.length; i++) {
        var f = forms[i];
        var ins = f.getElementsByTagName("input");
        var passEl = null, userEl = null, hidden = [];
        for (var j = 0; j < ins.length; j++) {
            var t = (ins[j].getAttribute("type") || "text").toLowerCase();
            var nm = ins[j].getAttribute("name") || ins[j].getAttribute("id") || "";
            if (t === "password" && !passEl) passEl = ins[j];
            else if (t === "hidden") hidden.push({ name: nm, value: ins[j].getAttribute("value") || "" });
            else if ((t === "text" || t === "email" || t === "tel") && nm) {
                // kullanici alani: ad/e-posta/login icerenleri oncele
                if (!userEl || /user|email|eposta|login|kullanici|uye|account|tckn|tc/i.test(nm)) userEl = ins[j];
            }
        }
        if (passEl) {
            return {
                action: absoluteUrl(baseUrl, f.getAttribute("action") || baseUrl),
                method: (f.getAttribute("method") || "POST").toUpperCase(),
                passName: passEl.getAttribute("name") || passEl.getAttribute("id") || "password",
                userName: userEl ? (userEl.getAttribute("name") || userEl.getAttribute("id")) : "",
                hidden: hidden
            };
        }
    }
    return null;
}

// Maskelenmis sifre gosterimi (raporda asla acik yazmaz)
function maskPass(p) { return p ? "•••••• (" + p.length + " karakter)" : "(bos)"; }

function autoLogin(session, loginUrl, userVal, passVal, userFieldOverride, passFieldOverride, timeoutSec) {
    var out = { ok: false, note: "", status: 0, action: "", userField: "", passField: "", usedHidden: 0, sessionCookieSeen: false };
    // 1) giris sayfasini al
    var res = httpGet(loginUrl, timeoutSec, session);
    out.status = res.status;
    if (res.error) { out.note = "Giris sayfasi alinamadi: " + res.error; return out; }
    var doc = parseHtml(res.body);
    var lf = doc ? findLoginForm(doc, loginUrl) : null;

    // alan adlarini belirle (override > otomatik > varsayilan)
    var userField = userFieldOverride || (lf && lf.userName) || "username";
    var passField = passFieldOverride || (lf && lf.passName) || "password";
    var action = (lf && lf.action) ? lf.action : loginUrl;
    var method = (lf && lf.method) ? lf.method : "POST";
    out.action = action; out.userField = userField; out.passField = passField;

    // 2) POST govdesini olustur: gizli alanlar (CSRF) + kullanici + sifre
    var pairs = [];
    if (lf && lf.hidden) {
        for (var h = 0; h < lf.hidden.length; h++) {
            if (lf.hidden[h].name) { pairs.push(encodeURIComponent(lf.hidden[h].name) + "=" + encodeURIComponent(lf.hidden[h].value)); out.usedHidden++; }
        }
    }
    pairs.push(encodeURIComponent(userField) + "=" + encodeURIComponent(userVal));
    pairs.push(encodeURIComponent(passField) + "=" + encodeURIComponent(passVal));
    var bodyStr = pairs.join("&");

    // 3) gonder (oturum cerezleri WinHttp tarafindan otomatik tutulur)
    var loginRes;
    if (method.indexOf("GET") === 0) {
        loginRes = httpGet(action + (action.indexOf("?") >= 0 ? "&" : "?") + bodyStr, timeoutSec, session);
    } else {
        loginRes = request("POST", action, bodyStr, "application/x-www-form-urlencoded", timeoutSec, session);
    }
    out.status = loginRes.status;
    if (loginRes.error) { out.note = "Giris istegi hatasi: " + loginRes.error; return out; }
    out.sessionCookieSeen = /set-cookie/i.test(loginRes.headers || "");

    // 4) basari sezgisi: panel sayfasini tekrar cek, sifre alani kaybolduysa / cikis linki varsa giris basarili
    var verify = httpGet(loginUrl, timeoutSec, session);
    var vbody = (verify.body || "").toLowerCase();
    var stillHasPassword = /type\s*=\s*["']?password/i.test(verify.body || "");
    var hasLogout = /(logout|cikis|çıkış|oturumu kapat|sign ?out|hesabim|hesabım|my account)/i.test(vbody);
    if (hasLogout || (!stillHasPassword && out.sessionCookieSeen)) {
        out.ok = true; out.note = "Giris basarili gorunuyor" + (hasLogout ? " (cikis/hesap baglantisi tespit edildi)." : " (sifre formu kayboldu, oturum cerezi alindi).");
    } else if (out.sessionCookieSeen) {
        out.ok = true; out.note = "Oturum cerezi alindi ancak dogrulama belirsiz; gezinme yine de oturumla yapilacak.";
    } else {
        out.ok = false; out.note = "Giris dogrulanamadi (oturum cerezi gorulmedi). Alan adlarini elle girmeyi deneyin.";
    }
    return out;
}

// ---- Giris alanlarini topla (etiket + amac ile) ----
function addFields(doc, coll, tag, target, markForm) {
    for (var i = 0; i < coll.length; i++) {
        var el = coll[i];
        var type = (el.getAttribute("type") || (tag === "input" ? "text" : tag)).toLowerCase();
        if (tag === "input" && /^(submit|button|reset|image)$/.test(type)) continue; // bunlar buton
        if (markForm) { el.__inForm = true; }
        else if (el.__inForm) { continue; } // form icinde zaten sayildi
        if (target.length >= 80) return;
        var label = fieldLabel(doc, el);
        var firstOpt = "";
        if (tag === "select") {
            try { var opts = el.getElementsByTagName("option"); if (opts.length) firstOpt = opts[0].getAttribute("value") || trim(opts[0].innerText || opts[0].textContent || ""); } catch (e) {}
        }
        target.push({
            tag: tag,
            type: type,
            name: el.getAttribute("name") || el.getAttribute("id") || "(adsiz)",
            label: label,
            required: el.getAttribute("required") !== null,
            min: el.getAttribute("min"),
            max: el.getAttribute("max"),
            maxlength: el.getAttribute("maxlength"),
            value: el.getAttribute("value") || "",
            firstOption: firstOpt,
            purpose: guessFieldPurpose(type, el.getAttribute("name") || el.getAttribute("id"), label)
        });
    }
}

// ---- Sayfanin ne ise yaradigini tahmin et ----
function guessPagePurpose(page) {
    var hay = ((page.title || "") + " " + (page.url || "") + " " + page.h1List.join(" ")).toLowerCase();
    var hints = [];
    // form alanlarina bak
    var hasPassword = false, hasEmail = false, hasSearch = false, hasFile = false;
    for (var i = 0; i < page.forms.length; i++) {
        for (var j = 0; j < page.forms[i].fields.length; j++) {
            var ty = (page.forms[i].fields[j].type || "").toLowerCase();
            var nm = (page.forms[i].fields[j].name || "").toLowerCase();
            if (ty === "password") hasPassword = true;
            if (ty === "email" || /e-?mail|eposta/.test(nm)) hasEmail = true;
            if (ty === "search" || /search|ara|query|q$/.test(nm)) hasSearch = true;
            if (ty === "file") hasFile = true;
        }
    }
    if (hasPassword && /kayit|register|sign ?up|uye/.test(hay)) hints.push("Kayit / uyelik sayfasi");
    else if (hasPassword) hints.push("Giris (oturum acma) sayfasi");
    if (hasSearch || /ara|search/.test(hay)) hints.push("Arama sayfasi");
    if (/sepet|cart|odeme|checkout|siparis|order/.test(hay)) hints.push("Sepet / odeme sureci");
    if (/iletisim|contact/.test(hay)) hints.push("Iletisim sayfasi");
    if (/hakkinda|about|kurumsal/.test(hay)) hints.push("Hakkinda / bilgi sayfasi");
    if (/blog|haber|news|makale|article/.test(hay)) hints.push("Icerik / blog sayfasi");
    if (hasFile) hints.push("Dosya yukleme islemi iceriyor");
    if (page.url.replace(/^https?:\/\/[^\/]+\/?/, "") === "") hints.push("Ana sayfa");
    if (page.forms.length > 0 && hints.length === 0) hints.push("Form/veri girisi iceren islem sayfasi");
    if (hints.length === 0) hints.push("Bilgilendirme / icerik sayfasi");
    return hints.join("; ");
}

// ---- Tek bir sayfayi analiz et ----
function analyzePage(url, timeoutSec, opts) {
    opts = opts || {};
    var page = {
        url: url, ok: false, status: 0, statusText: "", error: "",
        timeMs: 0, sizeBytes: 0, contentType: "", server: "",
        title: "", metaDesc: "", lang: "",
        headings: { h1:0,h2:0,h3:0,h4:0,h5:0,h6:0 }, h1List: [],
        links: [], internalLinks: [], externalLinks: [],
        navLinks: [], buttons: [], purpose: "",
        forms: [], scripts: 0, externalScripts: 0, styles: 0, images: 0, iframes: 0,
        tech: [], headers: ""
    };
    var res = httpGet(url, timeoutSec, opts.session);
    page.timeMs = res.timeMs;
    page.status = res.status;
    page.statusText = res.statusText;
    page.headers = res.headers;
    page.error = res.error;
    page.contentType = getHeaderValue(res.headers, "Content-Type");
    page.server = getHeaderValue(res.headers, "Server");
    page.sizeBytes = res.body ? res.body.length : 0;
    page.ok = res.ok && !res.error;
    if (!res.body) return page;

    page.tech = detectTech(res.headers, res.body);

    var doc = parseHtml(res.body);
    var domain = getDomain(url);

    if (doc) {
        try { page.title = trim(doc.title || ""); } catch (e) {}
        // meta description + lang
        try {
            var metas = doc.getElementsByTagName("meta");
            for (var mi = 0; mi < metas.length; mi++) {
                var nm = (metas[mi].name || "").toLowerCase();
                if (nm === "description") page.metaDesc = metas[mi].content || "";
            }
        } catch (e) {}
        try {
            var htmlEl = doc.getElementsByTagName("html");
            if (htmlEl.length) page.lang = htmlEl[0].getAttribute("lang") || "";
        } catch (e) {}

        // headings
        for (var hl = 1; hl <= 6; hl++) {
            try {
                var hs = doc.getElementsByTagName("h" + hl);
                page.headings["h"+hl] = hs.length;
                if (hl === 1) {
                    for (var hi = 0; hi < hs.length && hi < 10; hi++) {
                        var ht = trim(hs[hi].innerText || hs[hi].textContent || "");
                        if (ht) page.h1List.push(ht);
                    }
                }
            } catch (e) {}
        }

        // links + link metni (ne ise yaradigi)
        try {
            var as = doc.getElementsByTagName("a");
            var seen = {};
            for (var ai = 0; ai < as.length; ai++) {
                var href = as[ai].getAttribute("href");
                var abs = absoluteUrl(url, href);
                var ltext = trim(as[ai].innerText || as[ai].textContent || "");
                if (!ltext) ltext = trim(as[ai].getAttribute("title") || as[ai].getAttribute("aria-label") || "");
                if (!abs) continue;
                if (!seen[abs]) {
                    seen[abs] = true;
                    page.links.push(abs);
                    if (getDomain(abs) === domain) page.internalLinks.push(abs);
                    else page.externalLinks.push(abs);
                }
                // anlamli metni olan baglantilar = gezinme adimlari
                if (ltext && ltext.length <= 60 && page.navLinks.length < 60) {
                    page.navLinks.push({ text: ltext, url: abs, internal: (getDomain(abs) === domain), purpose: guessActionPurpose(ltext, abs) });
                }
            }
        } catch (e) {}

        // butonlar ve tiklanabilir ogeler (ne yaptiklari)
        try {
            collectButtons(doc.getElementsByTagName("button"), page, url, "button");
            var inps = doc.getElementsByTagName("input");
            for (var bi = 0; bi < inps.length; bi++) {
                var it = (inps[bi].getAttribute("type") || "text").toLowerCase();
                if (it === "submit" || it === "button" || it === "reset" || it === "image") {
                    var lbl = inps[bi].getAttribute("value") || inps[bi].getAttribute("alt") || (it === "submit" ? "Gonder" : it);
                    addButton(page, lbl, it, "input[type=" + it + "]");
                }
            }
            // role=button olan ogeler
            var allEls = doc.getElementsByTagName("*");
            for (var ri = 0; ri < allEls.length && page.buttons.length < 60; ri++) {
                if ((allEls[ri].getAttribute && allEls[ri].getAttribute("role")) === "button") {
                    var rt = trim(allEls[ri].innerText || allEls[ri].textContent || allEls[ri].getAttribute("aria-label") || "");
                    if (rt) addButton(page, rt, "role=button", allEls[ri].tagName.toLowerCase());
                }
            }
        } catch (e) {}

        // forms = surecler
        try {
            var fs = doc.getElementsByTagName("form");
            for (var fi = 0; fi < fs.length; fi++) {
                var f = fs[fi];
                var form = {
                    method: (f.getAttribute("method") || "GET").toUpperCase(),
                    action: absoluteUrl(url, f.getAttribute("action") || url),
                    name: f.getAttribute("name") || f.getAttribute("id") || ("Form #" + (fi+1)),
                    fields: []
                };
                addFields(doc, f.getElementsByTagName("input"), "input", form.fields, true);
                addFields(doc, f.getElementsByTagName("select"), "select", form.fields, true);
                addFields(doc, f.getElementsByTagName("textarea"), "textarea", form.fields, true);
                page.forms.push(form);
            }
        } catch (e) {}

        // form DISINDAKI giris alanlari (SPA / React vb. icin)
        try {
            var orphan = [];
            addFields(doc, doc.getElementsByTagName("input"), "input", orphan, false);
            addFields(doc, doc.getElementsByTagName("select"), "select", orphan, false);
            addFields(doc, doc.getElementsByTagName("textarea"), "textarea", orphan, false);
            if (orphan.length) {
                page.forms.push({ method: "JS/AJAX (form etiketi yok)", action: "(istemci tarafi)", name: "Form disi giris alanlari", fields: orphan });
            }
        } catch (e) {}

        // resources
        try {
            var scr = doc.getElementsByTagName("script");
            page.scripts = scr.length;
            for (var ssi = 0; ssi < scr.length; ssi++) { if (scr[ssi].getAttribute("src")) page.externalScripts++; }
        } catch (e) {}
        try { page.styles = doc.getElementsByTagName("link").length; } catch (e) {}
        try { page.images = doc.getElementsByTagName("img").length; } catch (e) {}
        try { page.iframes = doc.getElementsByTagName("iframe").length; } catch (e) {}
    }
    page.purpose = guessPagePurpose(page);

    // ---- test verisi / senaryo / (istege bagli) canli gonderim ----
    if (opts.genData) {
        for (var gi = 0; gi < page.forms.length; gi++) {
            var frm = page.forms[gi];
            frm.scenarios = buildScenarios(frm);
            frm.preview = buildFormRequest(frm, "valid"); // ne gonderilecegi (onizleme)
            frm.submissions = [];
            if (opts.liveSubmit && frm.fields.length && frm.action && frm.action !== "(istemci tarafi)") {
                for (var si = 0; si < frm.scenarios.length; si++) {
                    var sv = frm.scenarios[si];
                    if (sv.variant === "nav") continue;
                    var req = buildFormRequest(frm, sv.variant);
                    if (!req.url) continue;
                    var res = req.isGet
                        ? request("GET", req.url, null, null, timeoutSec, opts.session)
                        : request("POST", req.url, req.body, "application/x-www-form-urlencoded", timeoutSec, opts.session);
                    frm.submissions.push({ scenario: sv.name, variant: sv.variant, method: req.method, url: req.url, eval: evalResponse(sv.variant, res), status: res.status });
                }
            }
        }
    }
    return page;
}

// ---- Ana akis ----
function startAnalysis() {
    var url = trim($("urlInput").value);
    if (!/^https?:\/\/.+/i.test(url)) {
        setStatus("Lutfen gecerli bir URL girin (http:// veya https:// ile baslamali).", "err");
        return;
    }
    var timeoutSec = parseInt($("timeoutSec").value, 10) || 20;
    var crawl = $("crawlChk").checked;
    var maxPages = parseInt($("maxPages").value, 10) || 5;
    var genData = $("genDataChk").checked;
    var liveSubmit = $("liveSubmitChk").checked;
    var doLogin = $("loginChk").checked;

    if (liveSubmit) {
        var onay = confirm("DIKKAT: Canli gonderim acik.\n\nFormlar uretilen test verisiyle GERCEKTEN gonderilecek (GET ve POST). Bu, hedef sistemde kayit olusturma, mesaj gonderme gibi etkiler yaratabilir.\n\nYalnizca test etme YETKINIZ olan bir siteyse devam edin.\n\nDevam edilsin mi?");
        if (!onay) { setStatus("Canli gonderim iptal edildi. Onizleme modunda devam edebilirsiniz.", "warn"); return; }
    }

    var session = null, loginResult = null;
    if (doLogin) {
        var userVal = $("loginUser").value;
        var passVal = $("loginPass").value;
        if (!userVal || !passVal) { setStatus("Otomatik giris icin kullanici adi ve sifre gerekli.", "err"); return; }
        var onay2 = confirm("DIKKAT: Otomatik giris acik.\n\nGirdiginiz kimlik bilgileriyle siteye GERCEKTEN giris yapilacak ve oturum acikken sayfalar gezilecek.\n\nYalnizca giris yapma YETKINIZ olan (kendi/test) bir siteyse devam edin.\n\nDevam edilsin mi?");
        if (!onay2) { setStatus("Otomatik giris iptal edildi.", "warn"); return; }
        session = createSession();
        if (!session.ok) { setStatus("Oturum olusturulamadi (WinHttpRequest yok). Otomatik giris bu makinede desteklenmiyor.", "err"); return; }
        var loginUrl = trim($("loginUrl").value) || url;
        setStatus("Otomatik giris yapiliyor: " + esc(loginUrl) + " ...", "");
        loginResult = autoLogin(session, loginUrl, userVal, passVal, trim($("loginUserField").value), trim($("loginPassField").value), timeoutSec);
        session.loggedIn = loginResult.ok;
    }

    $("analyzeBtn").disabled = true;
    $("saveBtn").disabled = true;
    setStatus("Analiz ediliyor: " + esc(url) + " ...", "");

    var opts = { genData: genData, liveSubmit: liveSubmit, session: session };
    var pages = [];
    var queue = [url];
    var visited = {};
    var limit = crawl ? maxPages : 1;

    while (queue.length > 0 && pages.length < limit) {
        var cur = queue.shift();
        if (visited[cur]) continue;
        visited[cur] = true;
        setStatus("Analiz ediliyor (" + (pages.length+1) + "/" + limit + "): " + esc(cur), "");
        var p = analyzePage(cur, timeoutSec, opts);
        pages.push(p);
        if (crawl && pages.length < limit) {
            for (var i = 0; i < p.internalLinks.length && queue.length < limit*3; i++) {
                var nl = p.internalLinks[i].replace(/#.*$/, "");
                if (!visited[nl]) queue.push(nl);
            }
        }
    }

    lastReportHtml = buildReport(url, pages, { crawl: crawl, timeoutSec: timeoutSec, genData: genData, liveSubmit: liveSubmit, login: loginResult, passMask: doLogin ? maskPass($("loginPass").value) : "" });
    $("report").style.display = "block";
    $("report").innerHTML = lastReportHtml;
    $("analyzeBtn").disabled = false;
    $("saveBtn").disabled = false;

    var first = pages[0];
    if (first && first.ok) setStatus("Analiz tamamlandi. " + pages.length + " sayfa incelendi. Raporu kaydedebilirsiniz.", "ok");
    else if (first) setStatus("Analiz bitti ancak hedef yanit vermedi (durum: " + first.status + (first.error ? ", " + esc(first.error) : "") + ").", "warn");
    else setStatus("Analiz basarisiz.", "err");
}

// ---- Rapor olusturma ----
function statusClass(p) {
    if (p.error) return "err";
    if (p.status >= 200 && p.status < 300) return "ok";
    if (p.status >= 300 && p.status < 400) return "warn";
    return "err";
}

function buildReport(target, pages, opts) {
    var h = [];
    var now = new Date();
    h.push("<h2>Surec Analiz Raporu</h2>");
    h.push("<table>");
    h.push("<tr><th>Hedef</th><td>" + esc(target) + "</td></tr>");
    h.push("<tr><th>Tarih</th><td>" + esc(now.toLocaleString()) + "</td></tr>");
    h.push("<tr><th>Incelenen sayfa</th><td>" + pages.length + (opts.crawl ? " (tarama acik)" : "") + "</td></tr>");
    h.push("<tr><th>Zaman asimi</th><td>" + opts.timeoutSec + " sn</td></tr>");
    h.push("</table>");

    // toplam ozet
    var totForms = 0, totLinks = 0, totExt = 0, totTime = 0, totBtn = 0;
    for (var i = 0; i < pages.length; i++) {
        totForms += pages[i].forms.length;
        totLinks += pages[i].links.length;
        totExt += pages[i].externalLinks.length;
        totTime += pages[i].timeMs;
        totBtn += pages[i].buttons.length;
    }
    h.push("<h2>Genel Ozet</h2>");
    h.push("<table class='summary-grid'><tr>");
    h.push("<td><div class='num'>" + pages.length + "</div>Sayfa</td>");
    h.push("<td><div class='num'>" + totForms + "</div>Form / Surec</td>");
    h.push("<td><div class='num'>" + totBtn + "</div>Buton</td>");
    h.push("<td><div class='num'>" + (pages.length ? Math.round(totTime/pages.length) : 0) + " ms</div>Ort. Yanit</td>");
    h.push("</tr></table>");

    // OTOMATIK GIRIS sonucu
    if (opts.login) {
        var lg = opts.login;
        h.push("<h2>Otomatik Giris</h2>");
        h.push("<table>");
        h.push("<tr><th>Sonuc</th><td class='" + (lg.ok ? "ok" : "err") + "'>" + (lg.ok ? "BASARILI" : "BASARISIZ") + " &mdash; " + esc(lg.note) + "</td></tr>");
        h.push("<tr><th>Giris hedefi (action)</th><td class='muted'>" + esc(lg.action) + "</td></tr>");
        h.push("<tr><th>Kullanilan alanlar</th><td>kullanici: <b>" + esc(lg.userField) + "</b>, sifre: <b>" + esc(lg.passField) + "</b>, gizli/CSRF alan: " + lg.usedHidden + "</td></tr>");
        h.push("<tr><th>Sifre</th><td class='muted'>" + esc(opts.passMask) + " (raporda maskelenir)</td></tr>");
        h.push("<tr><th>Oturum cerezi</th><td>" + (lg.sessionCookieSeen ? "<span class='ok'>alindi</span>" : "<span class='warn'>gorulmedi</span>") + "</td></tr>");
        h.push("</table>");
        h.push("<p class='muted'>Asagidaki sayfalar " + (lg.ok ? "kimlik dogrulamali oturumla" : "oturum denemesinden sonra") + " gezilmistir.</p>");
    }

    // her sayfa
    for (var pi = 0; pi < pages.length; pi++) {
        var p = pages[pi];
        h.push("<h2>Sayfa " + (pi+1) + ": " + esc(p.url) + "</h2>");

        h.push("<table>");
        h.push("<tr><th>Sayfanin amaci</th><td><b>" + esc(p.purpose || "-") + "</b></td></tr>");
        h.push("<tr><th>Durum</th><td class='" + statusClass(p) + "'>" + p.status + " " + esc(p.statusText) + (p.error ? " &mdash; " + esc(p.error) : "") + "</td></tr>");
        h.push("<tr><th>Yanit suresi</th><td>" + p.timeMs + " ms</td></tr>");
        h.push("<tr><th>Boyut</th><td>" + Math.round(p.sizeBytes/1024) + " KB (" + p.sizeBytes + " byte)</td></tr>");
        h.push("<tr><th>Content-Type</th><td>" + esc(p.contentType) + "</td></tr>");
        h.push("<tr><th>Sunucu</th><td>" + esc(p.server || "-") + "</td></tr>");
        h.push("<tr><th>Sayfa basligi</th><td>" + esc(p.title || "-") + "</td></tr>");
        h.push("<tr><th>Dil</th><td>" + esc(p.lang || "-") + "</td></tr>");
        h.push("<tr><th>Aciklama (meta)</th><td>" + esc(p.metaDesc || "-") + "</td></tr>");
        h.push("</table>");

        // teknolojiler
        h.push("<b>Tespit edilen teknolojiler:</b><br>");
        if (p.tech.length) {
            for (var ti = 0; ti < p.tech.length; ti++) h.push("<span class='tag'>" + esc(p.tech[ti]) + "</span>");
        } else h.push("<span class='muted'>Belirgin teknoloji tespit edilemedi.</span>");
        h.push("<br>");

        // sayfa yapisi
        h.push("<b>Sayfa yapisi (basliklar):</b> ");
        h.push("H1:" + p.headings.h1 + " H2:" + p.headings.h2 + " H3:" + p.headings.h3 + " H4:" + p.headings.h4 + " H5:" + p.headings.h5 + " H6:" + p.headings.h6 + "<br>");
        if (p.h1List.length) {
            h.push("<span class='muted'>Ana basliklar: " + esc(p.h1List.join(" | ")) + "</span><br>");
        }

        // kaynaklar
        h.push("<b>Kaynaklar:</b> Script: " + p.scripts + " (harici: " + p.externalScripts + "), Stil/Link: " + p.styles + ", Gorsel: " + p.images + ", iFrame: " + p.iframes + "<br>");
        h.push("<b>Baglantilar:</b> Toplam " + p.links.length + " (ic: " + p.internalLinks.length + ", dis: " + p.externalLinks.length + ")<br>");

        // FORMLAR = SURECLER
        h.push("<h2 style='font-size:13px;border-bottom:1px dashed #ccc;'>Tespit edilen surecler (formlar)</h2>");
        if (p.forms.length === 0) {
            h.push("<span class='muted'>Bu sayfada form/etkilesimli surec tespit edilmedi.</span>");
        } else {
            for (var fi = 0; fi < p.forms.length; fi++) {
                var f = p.forms[fi];
                h.push("<div class='step'>");
                h.push("<b>Surec " + (fi+1) + ": " + esc(f.name) + "</b><br>");
                h.push("Yontem: <b>" + esc(f.method) + "</b> &rarr; Hedef: " + esc(f.action) + "<br>");
                if (f.fields.length) {
                    var showData = !!opts.genData;
                    h.push("<table style='margin-top:6px;'><tr><th>Alan (etiket)</th><th>Tur</th><th>Ne toplar (tahmin)</th><th>Zorunlu</th>" + (showData ? "<th>Uretilen test verisi</th>" : "") + "</tr>");
                    for (var fj = 0; fj < f.fields.length; fj++) {
                        var fld = f.fields[fj];
                        var disp = (fld.label && fld.label !== "(adsiz)") ? fld.label : fld.name;
                        h.push("<tr><td>" + esc(disp) + "</td><td>" + esc(fld.type) + "</td><td>" + esc(fld.purpose || "-") + "</td><td>" + (fld.required ? "<span class='err'>Evet</span>" : "Hayir") + "</td>");
                        if (showData) { var tv = generateTestValue(fld, "valid"); h.push("<td class='muted'>" + (tv === "" ? "(bos)" : esc(tv)) + "</td>"); }
                        h.push("</tr>");
                    }
                    h.push("</table>");
                } else h.push("<span class='muted'>Veri girisi alani yok (muhtemelen yalnizca buton iceriyor).</span>");

                // uretilen test senaryolari
                if (opts.genData && f.scenarios && f.scenarios.length) {
                    h.push("<div style='margin-top:8px;'><b>Otomatik test senaryolari:</b>");
                    h.push("<table><tr><th>#</th><th>Senaryo</th><th>Aciklama / beklenti</th></tr>");
                    for (var sj = 0; sj < f.scenarios.length; sj++) {
                        h.push("<tr><td>" + (sj+1) + "</td><td><b>" + esc(f.scenarios[sj].name) + "</b></td><td>" + esc(f.scenarios[sj].desc) + "</td></tr>");
                    }
                    h.push("</table></div>");
                }

                // gonderilecek istek onizlemesi
                if (opts.genData && f.preview && f.preview.action) {
                    h.push("<div style='margin-top:6px;'><b>Gonderilecek istek (onizleme):</b><br>");
                    h.push("<span class='tag'>" + esc(f.preview.method) + "</span> <span class='muted'>" + esc(f.preview.isGet ? f.preview.url : f.preview.action) + "</span>");
                    if (!f.preview.isGet) h.push("<pre>" + esc(f.preview.formBody) + "</pre>");
                    h.push("</div>");
                }

                // canli gonderim sonuclari
                if (f.submissions && f.submissions.length) {
                    h.push("<div style='margin-top:6px;'><b>Canli gonderim sonuclari:</b>");
                    h.push("<table><tr><th>Senaryo</th><th>Yontem</th><th>Durum</th><th>Degerlendirme</th></tr>");
                    for (var ui = 0; ui < f.submissions.length; ui++) {
                        var sub = f.submissions[ui];
                        h.push("<tr><td>" + esc(sub.scenario) + "</td><td>" + esc(sub.method) + "</td><td>" + sub.status + "</td><td class='" + sub.eval.verdict + "'>" + esc(sub.eval.note) + "</td></tr>");
                    }
                    h.push("</table></div>");
                }
                h.push("</div>");
            }
        }

        // BUTONLAR = ne yaptiklari
        h.push("<h2 style='font-size:13px;border-bottom:1px dashed #ccc;'>Butonlar / tiklanabilir ogeler (ne yapar)</h2>");
        if (p.buttons.length === 0) {
            h.push("<span class='muted'>Etiketli buton tespit edilmedi.</span>");
        } else {
            h.push("<table><tr><th>Buton / oge</th><th>Tur</th><th>Ne yapar (tahmin)</th></tr>");
            for (var bi = 0; bi < p.buttons.length; bi++) {
                var bt = p.buttons[bi];
                h.push("<tr><td>" + esc(bt.label) + "</td><td>" + esc(bt.type) + "</td><td>" + esc(bt.purpose) + "</td></tr>");
            }
            h.push("</table>");
        }

        // GEZINME ADIMLARI = baglantilarin ne ise yaradigi
        h.push("<h2 style='font-size:13px;border-bottom:1px dashed #ccc;'>Gezinme adimlari (baglantilar ne ise yarar)</h2>");
        if (p.navLinks.length === 0) {
            h.push("<span class='muted'>Etiketli gezinme baglantisi yok.</span>");
        } else {
            h.push("<table><tr><th>Baglanti metni</th><th>Ne ise yarar (tahmin)</th><th>Yon</th><th>Hedef</th></tr>");
            for (var ni = 0; ni < p.navLinks.length; ni++) {
                var nv = p.navLinks[ni];
                h.push("<tr><td>" + esc(nv.text) + "</td><td>" + esc(nv.purpose) + "</td><td>" + (nv.internal ? "ic" : "<span class='warn'>dis</span>") + "</td><td class='muted'>" + esc(nv.url) + "</td></tr>");
            }
            h.push("</table>");
        }

        // dis baglanti ornekleri
        if (p.externalLinks.length) {
            h.push("<details><summary style='cursor:pointer;margin-top:8px;'><b>Dis baglantilar (" + p.externalLinks.length + ")</b></summary>");
            h.push("<pre>");
            for (var ei = 0; ei < p.externalLinks.length && ei < 50; ei++) h.push(esc(p.externalLinks[ei]) + "\n");
            h.push("</pre></details>");
        }
        // HTTP basliklari
        if (p.headers) {
            h.push("<details><summary style='cursor:pointer;'><b>HTTP yanit basliklari</b></summary><pre>" + esc(p.headers) + "</pre></details>");
        }
    }

    // SURE​C AKISI (crawl modunda)
    if (opts.crawl && pages.length > 1) {
        h.push("<h2>Surec Akis Haritasi</h2>");
        h.push("<table><tr><th>#</th><th>Sayfa</th><th>Amaci</th><th>Form</th><th>Buton</th><th>Durum</th></tr>");
        for (var mi = 0; mi < pages.length; mi++) {
            var mp = pages[mi];
            h.push("<tr><td>" + (mi+1) + "</td><td class='muted'>" + esc(mp.url) + "</td><td>" + esc(mp.purpose) + "</td><td>" + mp.forms.length + "</td><td>" + mp.buttons.length + "</td><td class='" + statusClass(mp) + "'>" + mp.status + "</td></tr>");
        }
        h.push("</table>");
    }

    // SAYFALAR ARASI VERI TUTARLILIGI
    if (pages.length > 1) {
        // alan/deger haritasi: name -> { pages:{}, values:{} }
        var fieldMap = {};
        for (var ci = 0; ci < pages.length; ci++) {
            for (var cf = 0; cf < pages[ci].forms.length; cf++) {
                var ff = pages[ci].forms[cf].fields;
                for (var cj = 0; cj < ff.length; cj++) {
                    var nm = ff[cj].name;
                    if (!nm || nm === "(adsiz)") continue;
                    if (!fieldMap[nm]) fieldMap[nm] = { pages: {}, values: {}, type: ff[cj].type };
                    fieldMap[nm].pages[ci] = true;
                    var val = ff[cj].value || "";
                    if (val) fieldMap[nm].values[val] = true;
                }
            }
        }
        var shared = [];
        for (var key in fieldMap) {
            if (!fieldMap.hasOwnProperty(key)) continue;
            var pc = 0; for (var pk in fieldMap[key].pages) if (fieldMap[key].pages.hasOwnProperty(pk)) pc++;
            if (pc > 1) {
                var vals = []; for (var vk in fieldMap[key].values) if (fieldMap[key].values.hasOwnProperty(vk)) vals.push(vk);
                shared.push({ name: key, type: fieldMap[key].type, pageCount: pc, vals: vals });
            }
        }
        h.push("<h2>Sayfalar Arasi Veri Tutarliligi</h2>");
        if (shared.length === 0) {
            h.push("<span class='muted'>Birden fazla sayfada ortak gorulen ayni adli alan tespit edilmedi.</span>");
        } else {
            h.push("<p class='muted'>Ayni adla birden cok sayfada gorulen alanlar. Onceden dolu degeri tum sayfalarda ayni ise veri tasiniyor (oturum/CSRF/onceden dolu) demektir.</p>");
            h.push("<table><tr><th>Alan adi</th><th>Tur</th><th>Kac sayfada</th><th>Onceden dolu deger(ler)</th><th>Tutarlilik</th></tr>");
            for (var shi = 0; shi < shared.length; shi++) {
                var sh = shared[shi];
                var verdict, vstr;
                if (sh.vals.length === 0) { verdict = "<span class='muted'>deger yok</span>"; vstr = "-"; }
                else if (sh.vals.length === 1) { verdict = "<span class='ok'>AYNI (taşiniyor)</span>"; vstr = esc(sh.vals[0].length > 40 ? sh.vals[0].substr(0,40)+"..." : sh.vals[0]); }
                else { verdict = "<span class='warn'>FARKLI (degisiyor)</span>"; vstr = esc(sh.vals.length + " farkli deger"); }
                h.push("<tr><td>" + esc(sh.name) + "</td><td>" + esc(sh.type) + "</td><td>" + sh.pageCount + "</td><td class='muted'>" + vstr + "</td><td>" + verdict + "</td></tr>");
            }
            h.push("</table>");
        }
    }

    var disclaimer = opts.liveSubmit
        ? "Bu raporda CANLI GONDERIM yapilmistir (test verisiyle GET/POST istekleri gonderildi). Yalnizca yetkili test ortamlarinda kullanin."
        : "Yalnizca GET istekleri ve pasif DOM analizi yapilmistir; formlar gonderilmedi (onizleme modu).";
    h.push("<p class='muted' style='margin-top:18px;'>Bu rapor Web Surec Analizci (HTA) ile olusturulmustur. " + disclaimer + "</p>");
    return h.join("");
}

// ---- Raporu diske kaydet ----
function saveReport() {
    if (!lastReportHtml) { setStatus("Once analiz yapin.", "warn"); return; }
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var stamp = (new Date()).getTime();
        var fileName = "surec_raporu_" + stamp + ".html";
        // calisma klasoru
        var folder = "";
        try {
            var shell = new ActiveXObject("WScript.Shell");
            folder = shell.CurrentDirectory;
        } catch (e) {}
        var fullPath = (folder ? folder + "\\" : "") + fileName;
        var full = "<!DOCTYPE html><html><head><meta charset='utf-8'><title>Surec Raporu</title>" +
            "<style>body{font-family:Segoe UI,Arial,sans-serif;font-size:13px;color:#222;margin:24px;}" +
            "table{border-collapse:collapse;width:100%;margin-top:8px;font-size:12px;}" +
            "th,td{border:1px solid #dce1e7;padding:6px 9px;text-align:left;vertical-align:top;}" +
            "th{background:#eef2f6;}h2{color:#1f2d3d;border-bottom:2px solid #2d7ff9;padding-bottom:4px;}" +
            ".tag{display:inline-block;background:#eef2f6;border:1px solid #cdd6df;border-radius:3px;padding:1px 7px;margin:2px;font-size:11px;}" +
            ".ok{color:#1a8a4a;}.warn{color:#c47f00;}.err{color:#c0392b;}.muted{color:#888;}" +
            ".step{background:#f7f9fb;border-left:3px solid #2d7ff9;padding:8px 12px;margin:6px 0;}" +
            ".num{font-size:20px;font-weight:700;color:#2d7ff9;}pre{background:#f7f9fb;border:1px solid #e1e7ee;padding:8px;overflow:auto;}</style>" +
            "</head><body>" + lastReportHtml + "</body></html>";
        var file = fso.CreateTextFile(fullPath, true);
        file.Write(full);
        file.Close();
        setStatus("Rapor kaydedildi: " + esc(fullPath), "ok");
    } catch (e) {
        setStatus("Rapor kaydedilemedi: " + esc(e.message), "err");
    }
}

function clearReport() {
    $("report").innerHTML = "";
    $("report").style.display = "none";
    lastReportHtml = "";
    $("saveBtn").disabled = true;
    setStatus("Temizlendi.", "");
}

// pencere boyutu
window.resizeTo(900, 720);
</script>
</body>
</html>
